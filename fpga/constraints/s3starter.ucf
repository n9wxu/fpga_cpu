# Digilent Spartan-3 Starter Board (XC3S200-4FT256)
NET "clk"    LOC = "T9" | IOSTANDARD = LVCMOS33;
NET "clk"    TNM_NET = "clk";
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50%;

NET "btn0"   LOC = "M13" | IOSTANDARD = LVCMOS33;

NET "sw<0>"  LOC = "F12" | IOSTANDARD = LVCMOS33;
NET "sw<1>"  LOC = "G12" | IOSTANDARD = LVCMOS33;
NET "sw<2>"  LOC = "H14" | IOSTANDARD = LVCMOS33;
NET "sw<3>"  LOC = "H13" | IOSTANDARD = LVCMOS33;
NET "sw<4>"  LOC = "J14" | IOSTANDARD = LVCMOS33;
NET "sw<5>"  LOC = "J13" | IOSTANDARD = LVCMOS33;
NET "sw<6>"  LOC = "K14" | IOSTANDARD = LVCMOS33;
NET "sw<7>"  LOC = "K13" | IOSTANDARD = LVCMOS33;

NET "led<0>" LOC = "K12" | IOSTANDARD = LVCMOS33;
NET "led<1>" LOC = "P14" | IOSTANDARD = LVCMOS33;
NET "led<2>" LOC = "L12" | IOSTANDARD = LVCMOS33;
NET "led<3>" LOC = "N14" | IOSTANDARD = LVCMOS33;
NET "led<4>" LOC = "P13" | IOSTANDARD = LVCMOS33;
NET "led<5>" LOC = "N12" | IOSTANDARD = LVCMOS33;
NET "led<6>" LOC = "P12" | IOSTANDARD = LVCMOS33;
NET "led<7>" LOC = "P11" | IOSTANDARD = LVCMOS33;

# Four-digit seven-segment display: anodes and segments are active low.
# an<3> is the leftmost digit; seg<6:0> = g..a, seg<7> = decimal point.
NET "an<0>"  LOC = "D14" | IOSTANDARD = LVCMOS33;
NET "an<1>"  LOC = "G14" | IOSTANDARD = LVCMOS33;
NET "an<2>"  LOC = "F14" | IOSTANDARD = LVCMOS33;
NET "an<3>"  LOC = "E13" | IOSTANDARD = LVCMOS33;
NET "seg<0>" LOC = "E14" | IOSTANDARD = LVCMOS33;  # a
NET "seg<1>" LOC = "G13" | IOSTANDARD = LVCMOS33;  # b
NET "seg<2>" LOC = "N15" | IOSTANDARD = LVCMOS33;  # c
NET "seg<3>" LOC = "P15" | IOSTANDARD = LVCMOS33;  # d
NET "seg<4>" LOC = "R16" | IOSTANDARD = LVCMOS33;  # e
NET "seg<5>" LOC = "F13" | IOSTANDARD = LVCMOS33;  # f
NET "seg<6>" LOC = "N16" | IOSTANDARD = LVCMOS33;  # g
NET "seg<7>" LOC = "P16" | IOSTANDARD = LVCMOS33;  # dp

# VGA: one bit per colour through resistors; both syncs negative for 640x480.
NET "vga_r"  LOC = "R12" | IOSTANDARD = LVCMOS33;
NET "vga_g"  LOC = "T12" | IOSTANDARD = LVCMOS33;
NET "vga_b"  LOC = "R11" | IOSTANDARD = LVCMOS33;
NET "vga_hs" LOC = "R9"  | IOSTANDARD = LVCMOS33;
NET "vga_vs" LOC = "T10" | IOSTANDARD = LVCMOS33;

# Push buttons BTN0-BTN3 (BTN3 is the leftmost), as a bus for the system.
NET "btn<0>" LOC = "M13" | IOSTANDARD = LVCMOS33;
NET "btn<1>" LOC = "M14" | IOSTANDARD = LVCMOS33;
NET "btn<2>" LOC = "L13" | IOSTANDARD = LVCMOS33;
NET "btn<3>" LOC = "L14" | IOSTANDARD = LVCMOS33;

# 1 MB SRAM: two IS61LV25616AL-10 (256K x 16), shared address, WE# and OE#
# (Xilinx UG130, tables 2-1 to 2-4). sram_d<15:0> is IC10, <31:16> IC11.
NET "sram_a<0>"  LOC = "L5";
NET "sram_a<1>"  LOC = "N3";
NET "sram_a<2>"  LOC = "M4";
NET "sram_a<3>"  LOC = "M3";
NET "sram_a<4>"  LOC = "L4";
NET "sram_a<5>"  LOC = "G4";
NET "sram_a<6>"  LOC = "F3";
NET "sram_a<7>"  LOC = "F4";
NET "sram_a<8>"  LOC = "E3";
NET "sram_a<9>"  LOC = "E4";
NET "sram_a<10>" LOC = "G5";
NET "sram_a<11>" LOC = "H3";
NET "sram_a<12>" LOC = "H4";
NET "sram_a<13>" LOC = "J4";
NET "sram_a<14>" LOC = "J3";
NET "sram_a<15>" LOC = "K3";
NET "sram_a<16>" LOC = "K5";
NET "sram_a<17>" LOC = "L3";
NET "sram_d<0>"  LOC = "N7";
NET "sram_d<1>"  LOC = "T8";
NET "sram_d<2>"  LOC = "R6";
NET "sram_d<3>"  LOC = "T5";
NET "sram_d<4>"  LOC = "R5";
NET "sram_d<5>"  LOC = "C2";
NET "sram_d<6>"  LOC = "C1";
NET "sram_d<7>"  LOC = "B1";
NET "sram_d<8>"  LOC = "D3";
NET "sram_d<9>"  LOC = "P8";
NET "sram_d<10>" LOC = "F2";
NET "sram_d<11>" LOC = "H1";
NET "sram_d<12>" LOC = "J2";
NET "sram_d<13>" LOC = "L2";
NET "sram_d<14>" LOC = "P1";
NET "sram_d<15>" LOC = "R1";
NET "sram_d<16>" LOC = "P2";
NET "sram_d<17>" LOC = "N2";
NET "sram_d<18>" LOC = "M2";
NET "sram_d<19>" LOC = "K1";
NET "sram_d<20>" LOC = "J1";
NET "sram_d<21>" LOC = "G2";
NET "sram_d<22>" LOC = "E1";
NET "sram_d<23>" LOC = "D1";
NET "sram_d<24>" LOC = "D2";
NET "sram_d<25>" LOC = "E2";
NET "sram_d<26>" LOC = "G1";
NET "sram_d<27>" LOC = "F5";
NET "sram_d<28>" LOC = "C3";
NET "sram_d<29>" LOC = "K2";
NET "sram_d<30>" LOC = "M1";
NET "sram_d<31>" LOC = "N1";
NET "sram_ce_n<0>" LOC = "P7";     # CE1, IC10
NET "sram_ce_n<1>" LOC = "N5";     # CE2, IC11
NET "sram_be_n<0>" LOC = "P6";     # LB1
NET "sram_be_n<1>" LOC = "T4";     # UB1
NET "sram_be_n<2>" LOC = "P5";     # LB2
NET "sram_be_n<3>" LOC = "R4";     # UB2
NET "sram_oe_n"    LOC = "K4";
NET "sram_we_n"    LOC = "G3";
NET "sram_*" IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 6;
