# Digilent Spartan-3 Starter Board (XC3S200-4FT256)
NET "clk"    LOC = "T9" | IOSTANDARD = LVCMOS33;
NET "clk"    TNM_NET = "clk";
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50%;

NET "btn0"   LOC = "M13" | IOSTANDARD = LVCMOS33;

NET "sw<0>"  LOC = "F12" | IOSTANDARD = LVCMOS33;
NET "sw<1>"  LOC = "G12" | IOSTANDARD = LVCMOS33;
NET "sw<2>"  LOC = "H14" | IOSTANDARD = LVCMOS33;
NET "sw<3>"  LOC = "H13" | IOSTANDARD = LVCMOS33;
NET "sw<4>"  LOC = "J14" | IOSTANDARD = LVCMOS33;
NET "sw<5>"  LOC = "J13" | IOSTANDARD = LVCMOS33;
NET "sw<6>"  LOC = "K14" | IOSTANDARD = LVCMOS33;
NET "sw<7>"  LOC = "K13" | IOSTANDARD = LVCMOS33;

NET "led<0>" LOC = "K12" | IOSTANDARD = LVCMOS33;
NET "led<1>" LOC = "P14" | IOSTANDARD = LVCMOS33;
NET "led<2>" LOC = "L12" | IOSTANDARD = LVCMOS33;
NET "led<3>" LOC = "N14" | IOSTANDARD = LVCMOS33;
NET "led<4>" LOC = "P13" | IOSTANDARD = LVCMOS33;
NET "led<5>" LOC = "N12" | IOSTANDARD = LVCMOS33;
NET "led<6>" LOC = "P12" | IOSTANDARD = LVCMOS33;
NET "led<7>" LOC = "P11" | IOSTANDARD = LVCMOS33;

# Four-digit seven-segment display: anodes and segments are active low.
# an<3> is the leftmost digit; seg<6:0> = g..a, seg<7> = decimal point.
NET "an<0>"  LOC = "D14" | IOSTANDARD = LVCMOS33;
NET "an<1>"  LOC = "G14" | IOSTANDARD = LVCMOS33;
NET "an<2>"  LOC = "F14" | IOSTANDARD = LVCMOS33;
NET "an<3>"  LOC = "E13" | IOSTANDARD = LVCMOS33;
NET "seg<0>" LOC = "E14" | IOSTANDARD = LVCMOS33;  # a
NET "seg<1>" LOC = "G13" | IOSTANDARD = LVCMOS33;  # b
NET "seg<2>" LOC = "N15" | IOSTANDARD = LVCMOS33;  # c
NET "seg<3>" LOC = "P15" | IOSTANDARD = LVCMOS33;  # d
NET "seg<4>" LOC = "R16" | IOSTANDARD = LVCMOS33;  # e
NET "seg<5>" LOC = "F13" | IOSTANDARD = LVCMOS33;  # f
NET "seg<6>" LOC = "N16" | IOSTANDARD = LVCMOS33;  # g
NET "seg<7>" LOC = "P16" | IOSTANDARD = LVCMOS33;  # dp

# VGA: one bit per colour through resistors; both syncs negative for 640x480.
NET "vga_r"  LOC = "R12" | IOSTANDARD = LVCMOS33;
NET "vga_g"  LOC = "T12" | IOSTANDARD = LVCMOS33;
NET "vga_b"  LOC = "R11" | IOSTANDARD = LVCMOS33;
NET "vga_hs" LOC = "R9"  | IOSTANDARD = LVCMOS33;
NET "vga_vs" LOC = "T10" | IOSTANDARD = LVCMOS33;
