IO_PORT "O_sdram_addr[0]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "O_sdram_addr[1]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "O_sdram_addr[2]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "O_sdram_addr[3]" IO_TYPE=LVCMOS33 DRIVE=4;
