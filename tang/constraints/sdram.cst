// The SDRAM in the GW2AR-18's package: drive 4 mA (the default was stronger).
// With the bus held between writes (rtl/sdram_phy.v), this keeps the SDRAM's
// switching from upsetting the HDMI output: during SDRAM writes the TV
// dropped picture and sound (its audio packets are checked, its video is not).
IO_PORT "IO_sdram_dq[0]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[1]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[2]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[3]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[4]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[5]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[6]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[7]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[8]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[9]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[10]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[11]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[12]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "IO_sdram_dq[13]" IO_TYPE=LVCMOS33 DRIVE=4;
