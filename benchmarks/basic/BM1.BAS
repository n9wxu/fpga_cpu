100 REM RUGG/FELDMAN BASIC BENCHMARK 1 (KILOBAUD, JUNE 1977): AN EMPTY FOR LOOP
110 REM THE ORIGINAL TIMED FROM S TO E WITH A STOPWATCH; LINES 290 AND 710
120 REM READ THE CPU CYCLE COUNTER INSTEAD.
290 GOSUB 9000: H0 = CH: L0 = CL
300 PRINT "S"
400 FOR K = 1 TO 1000
500 NEXT K
700 PRINT "E"
710 GOSUB 9000: C = (CH - H0) * 65536 + (CL - L0): IF C > 0 THEN PRINT "CYCLES:"; C
800 END
9000 CH = DEEK(&HF00006): CL = DEEK(&HF00004): IF DEEK(&HF00006) <> CH THEN 9000
9010 RETURN
