10 REM DHRYSTONE 2.1 IN BASIC, TRANSLATED FROM R. P. WEICKER'S C VERSION
20 REM (dhry_1.c, dhry_2.c). RECORDS ARE PARALLEL ARRAYS INDEXED BY
30 REM "POINTER" (1 = PTR_GLOB, 2 = NEXT_PTR_GLOB), PROCEDURES ARE
40 REM SUBROUTINES, PARAMETERS ARE VARIABLES. IDENT_1..IDENT_5 = 0..4,
50 REM CHARACTERS ARE ASCII CODES, C'S TRUE/FALSE ARE 1/0.
60 REM SUBROUTINES: 1000 PROC_1  2000 PROC_2  3000 PROC_3  4000 PROC_4
70 REM 5000 PROC_5  6000 PROC_6  7000 PROC_7  8000 PROC_8  9000 CYCLES
80 REM 11000 FUNC_1  12000 FUNC_2  13000 FUNC_3  1900 STRUCT ASSIGN
100 NR% = 100: REM NUMBER OF RUNS
110 DIM A1%(50), A2%(50, 50), RP%(2), RD%(2), RE%(2), RI%(2), RS$(2)
120 PG% = 1: NG% = 2
130 RP%(PG%) = NG%: RD%(PG%) = 0: RE%(PG%) = 2: RI%(PG%) = 40
140 RS$(PG%) = "DHRYSTONE PROGRAM, SOME STRING"
150 S1$ = "DHRYSTONE PROGRAM, 1'ST STRING"
160 A2%(8, 7) = 10
170 PRINT "DHRYSTONE BENCHMARK, VERSION 2.1 (LANGUAGE: BASIC)"
180 PRINT "EXECUTION STARTS,"; NR%; "RUNS THROUGH DHRYSTONE"
190 GOSUB 9000: H0 = CH: L0 = CL: T0 = TIME
200 FOR RX% = 1 TO NR%
210 GOSUB 5000: GOSUB 4000
220 I1% = 2: I2% = 3: S2$ = "DHRYSTONE PROGRAM, 2'ND STRING": EL% = 1
230 GOSUB 12000: IF F2% THEN BG% = 0 ELSE BG% = 1
240 IF I1% >= I2% THEN 280
250 I3% = 5 * I1% - I2%
260 P1% = I1%: P2% = I2%: GOSUB 7000: I3% = PR%
270 I1% = I1% + 1: GOTO 240
280 P1% = I1%: P2% = I3%: GOSUB 8000
290 PV% = PG%: GOSUB 1000
300 FOR CI% = 65 TO CH2%
310 C1% = CI%: C2% = 67: GOSUB 11000
320 IF EL% = F1% THEN EV% = 0: GOSUB 6000: EL% = ER%: S2$ = "DHRYSTONE PROGRAM, 3'RD STRING": I2% = RX%: IG% = RX%
330 NEXT CI%
340 I2% = I2% * I1%: I1% = I2% \ I3%: I2% = 7 * (I2% - I3%) - I1%
350 IP% = I1%: GOSUB 2000: I1% = IP%
360 NEXT RX%
370 GOSUB 9000: T1 = TIME
380 PRINT "EXECUTION ENDS": PRINT
390 OK% = 1
400 PRINT "INT_GLOB:"; IG%; " SHOULD BE: 5": IF IG% <> 5 THEN OK% = 0
410 PRINT "BOOL_GLOB:"; BG%; " SHOULD BE: 1": IF BG% <> 1 THEN OK% = 0
420 PRINT "CH_1_GLOB: "; CHR$(CH1%); "  SHOULD BE: A": IF CH1% <> 65 THEN OK% = 0
430 PRINT "CH_2_GLOB: "; CHR$(CH2%); "  SHOULD BE: B": IF CH2% <> 66 THEN OK% = 0
440 PRINT "ARR_1_GLOB(8):"; A1%(8); " SHOULD BE: 7": IF A1%(8) <> 7 THEN OK% = 0
450 PRINT "ARR_2_GLOB(8,7):"; A2%(8, 7); " SHOULD BE:"; NR% + 10: IF A2%(8, 7) <> NR% + 10 THEN OK% = 0
460 PRINT "PTR_GLOB: DISCR"; RD%(PG%); " ENUM"; RE%(PG%); " INT"; RI%(PG%); " SHOULD BE: 0 2 17"
470 IF RD%(PG%) <> 0 OR RE%(PG%) <> 2 OR RI%(PG%) <> 17 THEN OK% = 0
480 PRINT "NEXT_PTR_GLOB: DISCR"; RD%(NG%); " ENUM"; RE%(NG%); " INT"; RI%(NG%); " SHOULD BE: 0 1 18"
490 IF RD%(NG%) <> 0 OR RE%(NG%) <> 1 OR RI%(NG%) <> 18 THEN OK% = 0
500 IF RS$(PG%) <> "DHRYSTONE PROGRAM, SOME STRING" OR RS$(NG%) <> RS$(PG%) THEN OK% = 0
510 IF RP%(PG%) <> RP%(NG%) THEN OK% = 0
520 PRINT "INT_1_LOC:"; I1%; " SHOULD BE: 5": IF I1% <> 5 THEN OK% = 0
530 PRINT "INT_2_LOC:"; I2%; " SHOULD BE: 13": IF I2% <> 13 THEN OK% = 0
540 PRINT "INT_3_LOC:"; I3%; " SHOULD BE: 7": IF I3% <> 7 THEN OK% = 0
550 PRINT "ENUM_LOC:"; EL%; " SHOULD BE: 1": IF EL% <> 1 THEN OK% = 0
560 PRINT "STR_1_LOC: "; S1$
570 PRINT "STR_2_LOC: "; S2$
580 IF S1$ <> "DHRYSTONE PROGRAM, 1'ST STRING" OR S2$ <> "DHRYSTONE PROGRAM, 2'ND STRING" THEN OK% = 0
590 IF OK% THEN PRINT "RESULTS CORRECT" ELSE PRINT "RESULTS WRONG"
600 C = (CH - H0) * 65536 + (CL - L0)
610 IF C <= 0 THEN PRINT "FRAMES:"; T1 - T0; "(NO CYCLE COUNTER)": END
620 PRINT "CYCLES:"; C
630 PRINT "CYCLES PER RUN:"; C / NR%
640 PRINT "DHRYSTONES PER SECOND AT 50 MHZ:"; NR% * 50000000 / C
650 PRINT "DMIPS:"; NR% * 50000000 / C / 1757
660 END
1000 REM PROC_1 (PTR_VAL_PAR = PV%)
1010 NX% = RP%(PV%)
1020 DS% = RP%(PV%): SR% = PG%: GOSUB 1900
1030 RI%(PV%) = 5
1040 RI%(NX%) = RI%(PV%)
1050 RP%(NX%) = RP%(PV%)
1060 RR% = NX%: GOSUB 3000
1070 IF RD%(NX%) <> 0 THEN DS% = PV%: SR% = RP%(PV%): GOSUB 1900: RETURN
1080 RI%(NX%) = 6
1090 EV% = RE%(PV%): GOSUB 6000: RE%(NX%) = ER%
1100 RP%(NX%) = RP%(PG%)
1110 P1% = RI%(NX%): P2% = 10: GOSUB 7000: RI%(NX%) = PR%
1120 RETURN
1900 REM STRUCTASSIGN: RECORD DS% = RECORD SR%
1910 RP%(DS%) = RP%(SR%): RD%(DS%) = RD%(SR%): RE%(DS%) = RE%(SR%)
1920 RI%(DS%) = RI%(SR%): RS$(DS%) = RS$(SR%): RETURN
2000 REM PROC_2 (INT_PAR_REF = IP%)
2010 IL% = IP% + 10
2020 IF CH1% = 65 THEN IL% = IL% - 1: IP% = IL% - IG%: EN% = 0
2030 IF EN% <> 0 THEN 2020
2040 RETURN
3000 REM PROC_3 (PTR_REF_PAR = RP%(RR%))
3010 IF PG% <> 0 THEN RP%(RR%) = RP%(PG%)
3020 P1% = 10: P2% = IG%: GOSUB 7000: RI%(PG%) = PR%
3030 RETURN
4000 REM PROC_4
4010 IF CH1% = 65 THEN BL% = 1 ELSE BL% = 0
4020 BG% = BL% OR BG%: CH2% = 66
4030 RETURN
5000 REM PROC_5
5010 CH1% = 65: BG% = 0
5020 RETURN
6000 REM PROC_6 (ENUM_VAL_PAR = EV%, ENUM_REF_PAR = ER%)
6010 ER% = EV%
6020 F3V% = EV%: GOSUB 13000: IF F3% = 0 THEN ER% = 3
6030 ON EV% + 1 GOTO 6040, 6050, 6070, 6080, 6090
6040 ER% = 0: RETURN
6050 IF IG% > 100 THEN ER% = 0 ELSE ER% = 3
6060 RETURN
6070 ER% = 1: RETURN
6080 RETURN
6090 ER% = 2: RETURN
7000 REM PROC_7 (INT_1_PAR_VAL = P1%, INT_2_PAR_VAL = P2%, INT_PAR_REF = PR%)
7010 IL% = P1% + 2: PR% = P2% + IL%
7020 RETURN
8000 REM PROC_8 (ARR_1_GLOB, ARR_2_GLOB, INT_1_PAR_VAL = P1%, INT_2_PAR_VAL = P2%)
8010 IL% = P1% + 5
8020 A1%(IL%) = P2%
8030 A1%(IL% + 1) = A1%(IL%)
8040 A1%(IL% + 30) = IL%
8050 FOR II% = IL% TO IL% + 1: A2%(IL%, II%) = IL%: NEXT II%
8060 A2%(IL%, IL% - 1) = A2%(IL%, IL% - 1) + 1
8070 A2%(IL% + 20, IL%) = A1%(IL%)
8080 IG% = 5
8090 RETURN
9000 REM CYCLE COUNTER (CYCLE_HI/LO): READ HI, LO, HI SO A CARRY CAN'T TEAR IT
9010 CH = DEEK(&HF00006): CL = DEEK(&HF00004): IF DEEK(&HF00006) <> CH THEN 9010
9020 RETURN
11000 REM FUNC_1 (CH_1_PAR_VAL = C1%, CH_2_PAR_VAL = C2%) -> F1%
11010 CL1% = C1%: CL2% = CL1%
11020 IF CL2% <> C2% THEN F1% = 0: RETURN
11030 CH1% = CL1%: F1% = 1
11040 RETURN
12000 REM FUNC_2 (STR_1_PAR_REF = S1$, STR_2_PAR_REF = S2$) -> F2%
12010 FL% = 2
12020 IF FL% > 2 THEN 12060
12030 C1% = ASC(MID$(S1$, FL% + 1, 1)): C2% = ASC(MID$(S2$, FL% + 2, 1)): GOSUB 11000
12040 IF F1% = 0 THEN CX% = 65: FL% = FL% + 1
12050 GOTO 12020
12060 IF CX% >= 87 AND CX% < 90 THEN FL% = 7
12070 IF CX% = 82 THEN F2% = 1: RETURN
12080 IF S1$ > S2$ THEN FL% = FL% + 7: IG% = FL%: F2% = 1: RETURN
12090 F2% = 0
12100 RETURN
13000 REM FUNC_3 (ENUM_PAR_VAL = F3V%) -> F3%
13010 IF F3V% = 2 THEN F3% = 1 ELSE F3% = 0
13020 RETURN
