# t1mplay: T1M modules (docs/t1m.md) on the Tang's microcoded audio engine, with a tracker view.
#   make                 build/demo.bin, build/sym40.bin, build/toccata.bin: the player with a song built in
#                        (demo: songs/demo.t1s; sym40 and toccata: Mozart and Bach converted from
#                        apps/sym40 and apps/toccata by songs/convert.py)
#   make run SONG=demo   load one on the Tang (needs the microcoded engine: cd ../../tang && make mcaudio prog-mc)
#   make fsim SONG=demo  8 s in fsim (--hw tang-mc): out/SONG.png and out/SONG.wav
#   make dump SONG=demo  print the module back (tools/t1mc.py --dump)
ROOT  := $(abspath ../..)
FCC   ?= $(ROOT)/llvm/fcc
FSIM  := $(ROOT)/sim/build/fsim
PY    := python3
BUILD := build
SONG  ?= demo
SONGS := demo sym40 toccata
INC   := -I src -I ../mcdemo/src -I ../mcdemo/build -I $(ROOT)/fpga/lib
SRC   := src/main.c src/t1m.c ../mcdemo/src/mc.c $(ROOT)/fpga/lib/irq.c

all: $(SONGS:%=$(BUILD)/%.bin)

$(BUILD)/demo.t1m: songs/demo.t1s tools/t1mc.py $(wildcard songs/samples/*.wav)
	@mkdir -p $(BUILD)
	$(PY) tools/t1mc.py $< $@

$(BUILD)/sym40.t1m $(BUILD)/toccata.t1m: $(BUILD)/%.t1m: songs/convert.py tools/t1mc.py
	@mkdir -p $(BUILD)
	$(PY) songs/convert.py $* $@

# a module as a C array (32-bit words: sample data stays aligned)
$(BUILD)/%/song.h: $(BUILD)/%.t1m
	@mkdir -p $(dir $@)
	$(PY) -c "import sys,struct; d=open(sys.argv[1],'rb').read(); d+=b'\0'*(-len(d)%4); w=struct.unpack('<%dI'%(len(d)//4),d); \
	open(sys.argv[2],'w').write('/* %s: generated by the Makefile */\nstatic const uint32_t song_t1m[%d] = {\n%s\n};\n' % \
	(sys.argv[1], len(w), ',\n'.join(', '.join('0x%08x'%x for x in w[i:i+8]) for i in range(0,len(w),8))))" $< $@

../mcdemo/build/mc_cs.h: $(ROOT)/fpga/tools/mcasm.py
	$(MAKE) -C ../mcdemo build/mc_cs.h

$(BUILD)/%.bin: $(SRC) $(wildcard src/*.h) $(BUILD)/%/song.h ../mcdemo/build/mc_cs.h
	$(FCC) -O2 -I $(BUILD)/$* $(INC) $(SRC) -o $@

run: $(BUILD)/$(SONG).bin
	$(PY) $(ROOT)/tang/tools/run.py $< -i

fsim: $(BUILD)/$(SONG).bin
	@mkdir -p out
	$(FSIM) -q --hw tang-mc --max-cycles 80000000 --wav out/$(SONG).wav --screenshot out/$(SONG).ppm $< </dev/null; test $$? -le 2
	@sips -s format png out/$(SONG).ppm --out out/$(SONG).png >/dev/null 2>&1 || true

dump: $(BUILD)/$(SONG).t1m
	$(PY) tools/t1mc.py --dump $<

clean:
	rm -rf $(BUILD) out

.PHONY: all run fsim dump clean
.SECONDARY:
