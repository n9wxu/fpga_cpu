# t1mplay: T1M modules (docs/t1m.md) on the Tang's microcoded audio engine, with a tracker view.
#   make                 build/t1mplay.bin with songs/demo.t1s built in
#   make SONG=x.t1s      another song built in
#   make run             load it on the Tang (needs the microcoded engine: cd ../../tang && make mcaudio prog-mc)
#   make fsim            8 s in fsim (--hw tang-mc): out/screen.png and out/song.wav
#   make dump            print the module back (tools/t1mc.py --dump)
ROOT  := $(abspath ../..)
FCC   ?= $(ROOT)/llvm/fcc
FSIM  := $(ROOT)/sim/build/fsim
PY    := python3
BUILD := build
SONG  ?= songs/demo.t1s
INC   := -I $(BUILD) -I src -I ../mcdemo/src -I ../mcdemo/build -I $(ROOT)/fpga/lib
SRC   := src/main.c src/t1m.c ../mcdemo/src/mc.c $(ROOT)/fpga/lib/irq.c

all: $(BUILD)/t1mplay.bin

$(BUILD)/song.t1m: $(SONG) tools/t1mc.py $(wildcard $(dir $(SONG))samples/*.wav)
	@mkdir -p $(BUILD)
	$(PY) tools/t1mc.py $(SONG) $@

$(BUILD)/song.h: $(BUILD)/song.t1m
	$(PY) -c "import sys,struct; d=open(sys.argv[1],'rb').read(); d+=b'\0'*(-len(d)%4); w=struct.unpack('<%dI'%(len(d)//4),d); \
	open(sys.argv[2],'w').write('/* %s: generated by the Makefile */\nstatic const uint32_t song_t1m[%d] = {\n%s\n};\n' % \
	(sys.argv[1], len(w), ',\n'.join(', '.join('0x%08x'%x for x in w[i:i+8]) for i in range(0,len(w),8))))" $< $@

../mcdemo/build/mc_cs.h: $(ROOT)/fpga/tools/mcasm.py
	$(MAKE) -C ../mcdemo build/mc_cs.h

$(BUILD)/t1mplay.bin: $(SRC) $(wildcard src/*.h) $(BUILD)/song.h ../mcdemo/build/mc_cs.h
	$(FCC) -O2 $(INC) $(SRC) -o $@

run: $(BUILD)/t1mplay.bin
	$(PY) $(ROOT)/tang/tools/run.py $< -i

fsim: $(BUILD)/t1mplay.bin
	@mkdir -p out
	$(FSIM) -q --hw tang-mc --max-cycles 80000000 --wav out/song.wav --screenshot out/screen.ppm $< </dev/null; test $$? -le 2
	@sips -s format png out/screen.ppm --out out/screen.png >/dev/null 2>&1 || true

dump: $(BUILD)/song.t1m
	$(PY) tools/t1mc.py --dump $<

clean:
	rm -rf $(BUILD) out

.PHONY: all run fsim dump clean
