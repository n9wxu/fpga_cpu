diff --git a/llvm/include/llvm/CodeGen/RDFRegisters.h b/llvm/include/llvm/CodeGen/RDFRegisters.h
index 7eed0b4e1..d6374ad89 100644
--- a/llvm/include/llvm/CodeGen/RDFRegisters.h
+++ b/llvm/include/llvm/CodeGen/RDFRegisters.h
@@ -371,7 +371,18 @@ private:
 } // namespace std
 
 namespace llvm::rdf {
-using RegisterSet = std::set<RegisterRef, std::less<RegisterRef>>;
+// A named comparator instead of std::less<RegisterRef>: newer libc++
+// requires std::less<Key> used by std::set to be an empty class.
+struct RegisterRefLess {
+  RegisterRefLess(const PhysicalRegisterInfo &pri) : PRI(&pri) {}
+  bool operator()(RegisterRef A, RegisterRef B) const {
+    return PRI->less(A, B);
+  }
+
+private:
+  const PhysicalRegisterInfo *PRI;
+};
+using RegisterSet = std::set<RegisterRef, RegisterRefLess>;
 } // namespace llvm::rdf
 
 #endif // LLVM_CODEGEN_RDFREGISTERS_H
