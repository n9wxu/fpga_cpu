READY.
10 DIM A(5), B$(3,2), C%(100)
20 FOR I=0 TO 5: A(I)=I*I: NEXT
30 FOR I=0 TO 3: FOR J=0 TO 2: B$(I,J)=CHR$(65+I)+STR$(J): NEXT J,I
40 PRINT A(5); B$(3,2); B$(0,0)
50 C%(100)=-7: PRINT C%(100); C%(0)
60 X(3)=9: PRINT X(3), X(10)
70 S$="": FOR I=1 TO 200: S$=S$+"X": IF LEN(S$)>100 THEN S$="" 
80 NEXT: PRINT LEN(S$), FRE(0)>1000
90 FOR K=1 TO 2000: T$=STR$(K)+"ABC"+T$: T$=LEFT$(T$,20): NEXT: PRINT T$
100 PRINT INSTR("HELLO WORLD","O"), INSTR("HELLO WORLD","O",6), INSTR("ABC","Z"), ASC("A")
110 DATA 1,"TWO, THREE", 4.5, HELLO WORLD ,-6
120 READ N1, S1$, N2, S2$, N3: PRINT N1;S1$;N2;"[";S2$;"]";N3
130 RESTORE: READ Q: PRINT Q
140 DEF FNSQ(X)=X*X+1: PRINT FNSQ(3), FNSQ(FNSQ(1))
150 ON 2 GOSUB 200,210,220: PRINT "AFTER ON"
160 X$="A": IF X$="A" AND 1 THEN PRINT "STR CMP OK"
170 IF "ABC"<"ABD" THEN PRINT "LESS"
180 PRINT X: X=5: PRINT X
190 END
200 PRINT "ONE": RETURN
210 PRINT "TWO": RETURN
220 PRINT "THREE": RETURN
RUN
 25 D 2A 0
-7  0 
 9               0 
 99             -1 
 2000ABC 1999ABC 199
 5               8               0               65 
 1 TWO, THREE 4.5 [HELLO WORLD]-6 
 1 
 10              5 
TWO
AFTER ON
STR CMP OK
LESS
 0 
 5 
READY.
