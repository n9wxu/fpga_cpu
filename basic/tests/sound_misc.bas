10 SOUND 0,440,10,2: WAVE 1,2: SOUND 1,220,8: BEEP: PAUSE 3: VSYNC
20 DOKE &HF00600,&HA5: PRINT HEX$(DEEK(&HF00600)); PEEK(&HF00600)
30 POKE 4096,200: PRINT PEEK(4096): DOKE 4096,-2: PRINT DEEK(4096)
40 A=RND(-5): B=RND(1): C=RND(0): PRINT B=C, RND(1)<1, RND(1)>=0
50 X=RND(-5): PRINT RND(1)=B
60 COLOR 2,8: LOCATE 3,10: PRINT "AT";: PRINT POS(0)
70 PRINT TIME>0
80 longvariablename1=1: longvariablename2=2: print longvariablename1+longvariablename2
90 GOTO100
100 PRINT "DONE"
RUN
LIST 80-
