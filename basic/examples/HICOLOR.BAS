10 REM HI-COLOR PALETTE BARS AND A COLOR WHEEL
20 HGR: CLS
30 FOR I=0 TO 255: PEN I: BOX I*2+60,10,I*2+61,60,1: NEXT
40 FOR I=0 TO 63: PALETTE 192+I,I*4,255-I*4,128: NEXT
50 FOR R=150 TO 2 STEP -2: PEN 192+(R/2) MOD 64: CIRCLE 320,220,R,1: NEXT
60 LOCATE 24,0: PRINT "HI-COLOR: 256 PALETTE ENTRIES";
