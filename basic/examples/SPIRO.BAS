10 REM SPIROGRAPH - LINES IN 8 COLORS
20 GR: BACKDROP 0: CLS
30 PRINT "SPIROGRAPH"
40 FOR S=1 TO 6
50 R1=60+RND(1)*100: R2=10+RND(1)*60: D=20+RND(1)*80
60 PEN 1+S MOD 7: T=0
70 X=320+R1-R2+D: Y=180: PLOT X,Y
80 FOR T=0 TO 6.283*R2/5 STEP .05
90 X=320+(R1-R2)*COS(T)+D*COS((R1-R2)/R2*T)
100 Y=180+(R1-R2)*SIN(T)-D*SIN((R1-R2)/R2*T)
110 LINE TO X,Y
120 NEXT T
130 PAUSE 30: GCLS
140 NEXT S
150 TEXT: PRINT "DONE"
