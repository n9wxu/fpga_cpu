10 REM CATCH THE STARS: ARROW KEYS MOVE, Q QUITS
20 GR: BACKDROP 0: CLS: COLOR 7
30 SPRITE 0 DEFINE 8,8 READ
40 DATA "...33...","..3333..",".333333.","33333333"
50 DATA "33.33.33","33333333","..3..3..",".3....3."
60 SPRITE 1 DEFINE 5,5,".....","..6..",".666.","..6..","....."
70 PEN 2: BOX 0,340,639,359,1
80 X=316: SX=RND(1)*600+20: SY=0: SC=0: MISS=0
90 LOCATE 0,0: PRINT "SCORE";SC;"  MISSED";MISS;"  "
100 K$=INKEY$: IF K$="" THEN 140
110 K=ASC(K$): IF K=130 THEN X=X-8
120 IF K=131 THEN X=X+8
130 IF K$="Q" OR K$="q" THEN 220
140 IF X<0 THEN X=0
150 IF X>632 THEN X=632
160 SY=SY+2+SC/5
170 IF SY>330 THEN IF ABS(SX-X-2)<8 THEN SC=SC+1: SOUND 0,880,12,4: GOTO 200
180 IF SY>340 THEN MISS=MISS+1: SOUND 1,110,12,10: GOTO 200
190 GOTO 210
200 SX=RND(1)*600+20: SY=0: GOSUB 90
210 SPRITE 0 AT X,330: SPRITE 1 AT SX,SY: VSYNC: IF MISS<5 THEN 100
220 SPRITE 0 OFF: SPRITE 1 OFF: VSYNC
230 LOCATE 10,30: PRINT "GAME OVER - SCORE";SC
240 TEXT
