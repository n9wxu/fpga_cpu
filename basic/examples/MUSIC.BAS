10 REM PLAY A TUNE ON THREE VOICES
20 WAVE 0,1: WAVE 1,0: WAVE 2,2
30 READ N: IF N<0 THEN 90
40 READ D: F=440*2^((N-9)/12)
50 SOUND 0,F,12: SOUND 1,F/2,6: SOUND 2,F*1.5,4
60 PRINT "NOTE";N;"FREQ";INT(F)
70 PAUSE D: SOUND 0,0,0: SOUND 1,0,0: SOUND 2,0,0: PAUSE 2
80 GOTO 30
90 PRINT "THE END"
100 DATA 0,15,2,15,4,15,5,15,7,30,7,30,9,15,9,15,9,15,9,15,7,60
110 DATA 5,15,5,15,5,15,5,15,4,30,4,30,2,15,2,15,2,15,2,15,0,60,-1
